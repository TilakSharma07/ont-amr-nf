/*
 * Resource caps for the stub run in CI.
 *
 * GitHub's ubuntu-latest runner has 4 CPUs. FLYE_ASSEMBLE carries
 * label 'process_high', which this repository defines as 10 CPUs, so Nextflow
 * refuses to schedule it:
 *
 *   Task requirement exceeds available CPUs -- req: 10; avail: 4
 *
 * Resource directives are enforced in -stub-run too, even though a stub only
 * runs a few printf calls. These caps exist solely so the DAG can be validated
 * on a small runner; they are never applied to a real run, which keeps using
 * the process_* labels defined in nextflow.config.
 *
 * withLabel overrides are used rather than process.resourceLimits because the
 * latter requires Nextflow >=24.04, which is exactly this pipeline's declared
 * floor -- these work on every supported version.
 */

process {
    withLabel: process_high   { cpus = 2; memory = 1.GB }
    withLabel: process_medium { cpus = 2; memory = 1.GB }
    withLabel: process_low    { cpus = 1; memory = 1.GB }
}
