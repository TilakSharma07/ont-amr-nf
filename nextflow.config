/*
 * ont-amr-nf : Oxford Nanopore reads -> validated antimicrobial-resistance gene calls
 *
 * Every threshold that could change a reported result is a parameter. Nothing that
 * affects a call is hidden in a module.
 */

manifest {
    name            = 'ont-amr-nf'
    author          = 'Tilak Sharma'
    description     = 'Reproducible ONT (R10.4.1) reads-to-AMR-call pipeline with explicit validation gates and controls'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.10.0'
    version         = '1.0.0'
}

params {
    help            = false

    // --- I/O ---
    samplesheet     = "${projectDir}/assets/samplesheet.csv"
    outdir          = 'results'

    // --- read filtering (nanoq) ---
    min_read_len    = 1000      // ONT: discard short fragments that do not help assembly
    min_read_q      = 10        // Q10 ~ 90% accuracy; R10.4.1 SUP reads sit well above this

    // --- assembly (flye) ---
    genome_size     = '5.3m'    // Enterobacterales; used only for flye's coverage heuristics
    flye_mode       = '--nano-hq'   // correct mode for R10.4.1 + SUP basecalling
    flye_iterations = 2

    // --- validation gates: a sample failing any of these is reported, not silently passed ---
    min_depth_x        = 20     // below this, AMR absence is not interpretable (see depth titration)
    min_n50            = 50000
    min_total_len      = 4000000
    max_total_len      = 7000000
    max_contigs        = 200

    // --- AMR calling (AMRFinderPlus) ---
    amr_min_ident      = 0.9    // proportion, AMRFinderPlus --ident_min
    amr_min_cov        = 0.5    // AMRFinderPlus --coverage_min
    amrfinder_db       = null   // null = use the database bundled with the conda install

    // --- negative control ---
    make_decoy         = true
    decoy_from         = null   // sample_id to derive the decoy from; null = first sample
    // Caller-level control: shuffle a real assembly and re-call it. Tests the gene
    // caller itself, which the read-level decoy cannot do (it never assembles).
    caller_control     = true

    // --- depth titration experiment ---
    run_titration      = false
    titration_sample   = null
    titration_depths   = '5,10,20,40,80'
    titration_replicates = 2
    titration_seed     = 42

    // Where already-downloaded reads live. Checked before hitting SRA, so a run on
    // an offline machine (or one with the data on an external volume) stays offline.
    reads_dir          = null

    publish_mode       = 'copy'
    // Peak disk usage scales with the number of assemblies running AT ONCE, not with
    // the number of samples, because each Flye job's intermediates are removed when it
    // finishes. Lower this on a small disk; raise it on a cluster.
    max_assembly_forks = 2
    max_cpus           = 12
    max_memory         = '12.GB'
    max_time           = '24.h'
}

process {
    errorStrategy = { task.exitStatus in [143,137,104,134,139] ? 'retry' : 'finish' }
    maxRetries    = 2

    withLabel: process_low {
        cpus   = 2
        memory = '2.GB'
        time   = '1.h'
    }
    withLabel: process_medium {
        cpus   = 4
        memory = '6.GB'
        time   = '4.h'
    }
    withLabel: process_high {
        cpus     = { Math.min(params.max_cpus as int, 10) }
        memory   = '11.GB'
        time     = '12.h'
        maxForks = params.max_assembly_forks
    }
}

profiles {
    conda {
        conda.enabled          = true
        conda.useMicromamba    = true
        conda.cacheDir         = "${projectDir}/.conda-cache"
    }
    // For a work directory on a filesystem without symlink support (FAT32/exFAT
    // external drives, some network mounts). Nextflow stages inputs as symlinks by
    // default; copy mode removes that requirement at the cost of extra I/O. Combine
    // with -work-dir pointing at the volume, e.g.
    //   nextflow run . -profile conda,portable_fs -work-dir /media/usb/work
    portable_fs {
        process.stageInMode    = 'copy'
        process.stageOutMode   = 'copy'
    }
    docker {
        docker.enabled         = true
        docker.runOptions      = '-u $(id -u):$(id -g)'
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
    }
    // Uses the pre-built local environment instead of resolving one per process.
    local_env {
        conda.enabled          = false
        process.conda          = null
    }
    test {
        params.min_read_len    = 500
        params.titration_depths = '10,20'
        params.titration_replicates = 1
    }
}

// Full provenance capture: every run is self-documenting. Nextflow fills in
// the run timestamp itself, so no variable declaration is needed here (and
// Nextflow 26.x forbids one in a config file).
timeline { enabled = true; file = "${params.outdir}/pipeline_info/timeline.html"; overwrite = true }
report   { enabled = true; file = "${params.outdir}/pipeline_info/report.html";   overwrite = true }
trace    { enabled = true; file = "${params.outdir}/pipeline_info/trace.txt";     overwrite = true }
dag      { enabled = true; file = "${params.outdir}/pipeline_info/dag.html";      overwrite = true }
